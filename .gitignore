# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# TWA (Android) signing keystore — never commit. Play Store requires the
# exact same file to sign every future app update.
/twa/*.keystore
/twa/*.keystore.old
/twa/KEYSTORE_CREDENTIALS.txt
/twa/android.keystore.properties

# local Claude Code/Cowork tool settings
.claude/

# Bubblewrap-generated Android project (regenerate with `bubblewrap update`)
/twa/android/
